# apps/shop — copy to .env.local for development. NEVER commit real values.
APP_ENV=development
LOG_LEVEL=info

# Firebase (shop service account; customer accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Payment provider (hosted checkout). Use TEST keys outside production.
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Resend (order confirmations)
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL=
