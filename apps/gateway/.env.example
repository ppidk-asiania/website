# apps/gateway — copy to .env.local for development. NEVER commit real values.
# With no .env.local, `pnpm dev` runs as APP_ENV=development with in-memory adapters.
APP_ENV=development
LOG_LEVEL=info
PORT=3003

# HMAC pepper for API-key hashes (>= 32 chars). Different per environment.
API_KEY_PEPPER=
GATEWAY_RATE_LIMIT_PER_MINUTE=60
# Connection-pool cap for the gateway's own database role
GATEWAY_DB_MAX_CONNECTIONS=5

# Firebase (gateway service account — read published events, write registrations only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_EMULATOR_HOST=
