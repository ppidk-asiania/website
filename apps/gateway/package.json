{
  "name": "gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "@website/apikeys": "workspace:*",
    "@website/config": "workspace:*",
    "@website/contracts": "workspace:*",
    "@website/db": "workspace:*",
    "@website/domain": "workspace:*",
    "@website/observability": "workspace:*",
    "hono": "4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
