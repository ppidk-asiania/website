# apps/admin — copy to .env.local for development. NEVER commit real values.
APP_ENV=development
LOG_LEVEL=info

# Firebase Admin (admin service account — staging/production are SEPARATE projects)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# Firebase web config (public by design; used by the sign-in page)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Staff session lifetime in hours (1-12)
SESSION_MAX_AGE_HOURS=8

# Resend (transactional email + newsletter broadcasts)
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL=
EMAIL_FROM_NEWSLETTER=
RESEND_WEBHOOK_SECRET=

# Zoom Server-to-Server OAuth (meeting requests)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Signed ICS calendar feed
CALENDAR_FEED_SIGNING_SECRET=

# Per-IP rate limiting (HMAC key, >= 32 chars). Required in staging/production; different per environment.
RATE_LIMIT_SECRET=
