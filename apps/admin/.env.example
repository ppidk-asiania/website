# apps/admin — copy to .env.local for development. NEVER commit real values.
APP_ENV=development
LOG_LEVEL=info

# Firebase Admin (admin service account; one Firebase project for every environment)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Firebase web config (public by design; used by the sign-in page)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Staff session lifetime in hours (1-12)
SESSION_MAX_AGE_HOURS=8
# ONE session shared by web, admin and shop: the parent domain, e.g. ppiasiania.id (empty = host-only, local dev)
SESSION_COOKIE_DOMAIN=

# Sign-in happens on the web app, which sends the user back here. Without both, signed-out
# visitors see "sign-in required" instead of being redirected. Local: http://localhost:3000 and :3001
WEB_URL=
ADMIN_URL=

# Outgoing messages: empty or log = record only (default, every environment shares the live data);
# live = send in production; elsewhere only to MESSAGING_TEST_RECIPIENTS (comma-separated e-mails)
MESSAGING_MODE=
MESSAGING_TEST_RECIPIENTS=

# Resend (transactional email + newsletter broadcasts)
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL=
EMAIL_FROM_NEWSLETTER=
RESEND_WEBHOOK_SECRET=

# Zoom Server-to-Server OAuth (meeting requests)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Signed ICS calendar feed
CALENDAR_FEED_SIGNING_SECRET=

# cPanel Cron Jobs call GET /cron/<job> with "Authorization: Bearer <this>" (>= 32 chars).
# Also stored in ~/.config/ppidk/cron-secret on the server (chmod 600). Empty = every cron call is 401.
CRON_SECRET=

# Per-IP rate limiting (HMAC key, >= 32 chars). Required in staging/production; different per environment.
RATE_LIMIT_SECRET=
