# apps/store — copy to .env.local for development. NEVER commit real values.
APP_ENV=development
LOG_LEVEL=info

# MySQL on cPanel (all data, including sign-in accounts). Each app its own MySQL user (cPanel → MySQL Databases).
# mysql://<cpaneluser_app>:<password>@localhost:3306/<cpaneluser_ppidk>; locally a staging copy or Remote MySQL.
DATABASE_URL=
DATABASE_CONNECTION_LIMIT=5

# Payment provider (hosted checkout). Use TEST keys outside production.
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Customer session lifetime in hours (1-12)
SESSION_MAX_AGE_HOURS=8
# ONE session shared by web, admin and store: the parent domain, e.g. ppiasiania.id (empty = host-only, local dev)
SESSION_COOKIE_DOMAIN=
# Signs session cookies and sign-in e-mail links (>= 32 chars). The SAME value on web, admin and store;
# changing it signs everybody out and voids unused reset links.
SESSION_SECRET=

# Resend (order confirmations)
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL=

# Per-IP rate limiting (HMAC key, >= 32 chars). Required in staging/production; different per environment.
RATE_LIMIT_SECRET=
