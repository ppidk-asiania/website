# apps/web — copy to .env.local for development. NEVER commit real values.
APP_ENV=development
LOG_LEVEL=info

# Firebase Admin (web service account: public content read + own member profile)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Local emulators (development/test only — rejected in staging/production)
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# Firebase web config (public by design; member sign-in — same user pool as admin/shop)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public URL of this site, e.g. http://localhost:3000. Passkeys are bound to its hostname.
WEB_URL=
# Use the Firebase Auth emulator from the browser (development only), e.g. 127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# Member session lifetime in hours (1-12)
SESSION_MAX_AGE_HOURS=8

# reCAPTCHA v3 (public forms)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Per-IP rate limiting (HMAC key, >= 32 chars). Required in staging/production; different per environment.
RATE_LIMIT_SECRET=
