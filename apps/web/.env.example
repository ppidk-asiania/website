# apps/web — copy to .env.local for development. NEVER commit real values.
APP_ENV=development
LOG_LEVEL=info

# Firebase Admin (web service account: public content read + own member profile)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Firebase web config (public by design; member sign-in — same user pool as admin/shop)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public URL of this site, e.g. http://localhost:3000. Passkeys are bound to its hostname.
WEB_URL=

# Member session lifetime in hours (1-12)
SESSION_MAX_AGE_HOURS=8
# ONE session shared by web, admin and shop: the parent domain, e.g. ppiasiania.id (empty = host-only, local dev)
SESSION_COOKIE_DOMAIN=

# Other apps that may be returned to after sign-in (/login?next=…), without them web refuses to return there. Local: http://localhost:3001 and :3002
ADMIN_URL=
SHOP_URL=

# reCAPTCHA v3 (public forms)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Confirmation e-mails (event registration, newsletter opt-in) — same settings as apps/admin
# live = send in production; elsewhere only to MESSAGING_TEST_RECIPIENTS (comma-separated e-mails)
MESSAGING_MODE=
MESSAGING_TEST_RECIPIENTS=
RESEND_API_KEY=
EMAIL_FROM_TRANSACTIONAL=

# Newsletter (>= 32 chars each, different per environment). The hash secret is the subscriber id
# key: never rotate it. The link secret signs unsubscribe links (admin campaigns use the same one).
SUBSCRIBER_HASH_SECRET=
LINK_SIGNING_SECRET=

# Per-IP rate limiting (HMAC key, >= 32 chars). Required in staging/production; different per environment.
RATE_LIMIT_SECRET=
